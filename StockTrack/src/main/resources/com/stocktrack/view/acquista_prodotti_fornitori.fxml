<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="page" xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.stocktrack.view.fx.controller.AcquistaProdottiFornitoriFXController">
    <top>
        <VBox spacing="4" styleClass="header">
            <padding>
                <Insets top="18" right="24" bottom="12" left="24"/>
            </padding>
            <Label styleClass="title" text="Acquisto prodotti da fornitore"/>
            <Label styleClass="subtitle" text="Flusso dimostrativo StockTrack"/>
            <Button onAction="#onBackToInventory" text="Torna all'inventario"/>
        </VBox>
    </top>
    <center>
        <GridPane hgap="18" vgap="14" styleClass="content">
            <padding>
                <Insets top="18" right="24" bottom="18" left="24"/>
            </padding>

            <VBox GridPane.columnIndex="0" GridPane.rowIndex="0" spacing="10" styleClass="panel">
                <Label styleClass="section-title" text="Fornitore"/>
                <ComboBox fx:id="supplierComboBox" maxWidth="Infinity"/>
                <Button onAction="#onLoadProducts" text="Carica prodotti"/>
                <ListView fx:id="supplierProductsListView" prefHeight="250"/>
                <HBox spacing="8">
                    <TextField fx:id="quantityField" prefWidth="120" promptText="Quantita"/>
                    <Button onAction="#onAddToCart" text="Aggiungi"/>
                </HBox>
            </VBox>

            <VBox GridPane.columnIndex="1" GridPane.rowIndex="0" spacing="10" styleClass="panel">
                <Label styleClass="section-title" text="Carrello"/>
                <ListView fx:id="cartListView" prefHeight="250"/>
                <Label fx:id="totalLabel" styleClass="total" text="Totale: 0 EUR"/>

                <Label styleClass="section-title" text="Pagamento"/>
                <HBox spacing="16">
                    <RadioButton fx:id="visaRadioButton" text="Visa"/>
                    <RadioButton fx:id="paypalRadioButton" text="PayPal"/>
                </HBox>
                <TextField fx:id="cardNumberField" promptText="Numero carta Visa"/>
                <TextField fx:id="cvvField" promptText="CVV"/>
                <TextField fx:id="paypalEmailField" promptText="Email PayPal"/>
                <Button maxWidth="Infinity" onAction="#onPayAndConfirm" text="Paga e conferma ordine"/>
                <Label fx:id="messageLabel" styleClass="message"/>
            </VBox>
        </GridPane>
    </center>
</BorderPane>
