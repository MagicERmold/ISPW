<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="14" styleClass="content-view" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.stocktrack.view.fx.controller.ActivityLogGraphicalController">
    <padding>
        <Insets top="22" right="24" bottom="24" left="24"/>
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="section-header-inline">
        <Label styleClass="section-title" text="Attivita recenti" />
        <Region HBox.hgrow="ALWAYS" />
        <Button onAction="#handleRefresh" styleClass="secondary-button" text="Aggiorna"/>
    </HBox>

    <TableView fx:id="activityTable" styleClass="data-table" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="timestampCol" text="Data" prefWidth="140"/>
            <TableColumn fx:id="usernameCol" text="Utente" prefWidth="150"/>
            <TableColumn fx:id="actionCol" text="Tipo" prefWidth="130"/>
            <TableColumn fx:id="descriptionCol" text="Descrizione" prefWidth="440"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
        <placeholder>
            <Label text="Nessuna attivita registrata."/>
        </placeholder>
    </TableView>
</VBox>
