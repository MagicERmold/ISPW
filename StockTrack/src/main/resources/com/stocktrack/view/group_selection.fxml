<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane styleClass="auth-screen" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.stocktrack.view.fx.controller.GroupSelectionGraphicalController">
    <VBox alignment="CENTER_LEFT" maxWidth="520.0" spacing="18.0" styleClass="group-card">
        <padding>
            <Insets bottom="42.0" left="42.0" right="42.0" top="42.0" />
        </padding>

        <Label styleClass="title-label" text="Configura gruppo" />
        <Label styleClass="text-secondary" text="Non appartieni ancora a nessun magazzino." />

        <VBox alignment="CENTER_LEFT" maxWidth="420.0" spacing="12.0" styleClass="choice-panel">
            <RadioButton fx:id="createRadio" selected="true" text="Crea un nuovo gruppo">
                <toggleGroup>
                    <ToggleGroup fx:id="groupToggle" />
                </toggleGroup>
            </RadioButton>

            <RadioButton fx:id="joinRadio" text="Unisciti a un gruppo esistente" toggleGroup="$groupToggle" />

            <TextField fx:id="groupIdField" promptText="ID gruppo" visible="false" />
        </VBox>

        <Button maxWidth="420.0" onAction="#handleContinue" prefWidth="420.0" styleClass="primary-button" text="Continua" />
    </VBox>
</StackPane>
