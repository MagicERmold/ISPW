<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.stocktrack.view.fx.controller.GroupSelectionGraphicalController">
    <padding> <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" /> </padding>

    <Label text="Benvenuto! Configura il tuo Gruppo">
        <font> <Font size="18.0" /> </font>
    </Label>
    <Label text="Non appartieni ancora a nessun magazzino." textFill="GREY"/>

    <VBox spacing="10" alignment="CENTER_LEFT" maxWidth="400">
        <RadioButton fx:id="createRadio" text="Crea un nuovo Gruppo (Diventerai Admin)" selected="true">
            <toggleGroup>
                <ToggleGroup fx:id="groupToggle"/>
            </toggleGroup>
        </RadioButton>

        <RadioButton fx:id="joinRadio" text="Unisciti a un gruppo esistente" toggleGroup="$groupToggle"/>

        <TextField fx:id="groupIdField" promptText="Inserisci ID Gruppo qui..." visible="false"/>
    </VBox>

    <Label fx:id="errorLabel" textFill="RED"/>

    <Button text="Continua" onAction="#handleContinue" prefWidth="150"/>
</VBox>