<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.layout.BorderPane?>

<?import javafx.scene.layout.Pane?>
<?import javafx.scene.control.Separator?>
<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.stocktrack.view.fx.controller.HomeGraphicalController">
    <top>
        <ToolBar>
            <Label fx:id="welcomeLabel" text="StockTrack" styleClass="title-label"/>

            <Separator orientation="VERTICAL" />

            <Button text="Registra Acquisto (+)" onAction="#handlePurchase" styleClass="action-button"/>
            <Button text="Registra Consumo (-)" onAction="#handleConsumption" styleClass="danger-button"/>

            <Pane/>

            <Button text="Logout" onAction="#handleLogout"/>
        </ToolBar>
    </top>
    <center>
        <TabPane fx:id="mainTabPane" tabClosingPolicy="UNAVAILABLE">
            <Tab text="Magazzino" onSelectionChanged="#refreshTabs">
                <fx:include fx:id="stockView" source="stock_view.fxml"/>
            </Tab>

            <Tab text="Lista Spesa (Sottoscorta)" onSelectionChanged="#refreshTabs">
                <fx:include fx:id="shoppingView" source="shopping_list.fxml"/>
            </Tab>

            <Tab text="Gestione Utenti" fx:id="usersTab" onSelectionChanged="#refreshTabs">
                <fx:include fx:id="usersView" source="users_view.fxml"/>
            </Tab>
        </TabPane>
    </center>
</BorderPane>