<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="app-root" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.stocktrack.view.fx.controller.HomeGraphicalController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="14.0" styleClass="app-toolbar">
            <VBox spacing="2.0">
                <Label styleClass="app-title" text="StockTrack" />
                <Label fx:id="welcomeLabel" styleClass="user-badge" text="Ciao" />
            </VBox>

            <Region HBox.hgrow="ALWAYS" />

            <Button onAction="#handlePurchase" styleClass="primary-button" text="+ Acquisto" />
            <Button onAction="#handleConsumption" styleClass="danger-button" text="- Consumo" />

            <Button onAction="#handleLogout" styleClass="secondary-button" text="Logout" />
        </HBox>
    </top>
    <center>
        <TabPane fx:id="mainTabPane" styleClass="main-tabs" tabClosingPolicy="UNAVAILABLE">
            <Tab text="Magazzino" onSelectionChanged="#refreshTabs">
                <fx:include fx:id="stockView" source="stock_view.fxml"/>
            </Tab>

            <Tab text="Lista Spesa (Sottoscorta)" onSelectionChanged="#refreshTabs">
                <fx:include fx:id="shoppingView" source="shopping_list.fxml"/>
            </Tab>

            <Tab text="Gestione Utenti" fx:id="usersTab" onSelectionChanged="#refreshTabs">
                <fx:include fx:id="usersView" source="users_view.fxml"/>
            </Tab>
        </TabPane>
    </center>
</BorderPane>
