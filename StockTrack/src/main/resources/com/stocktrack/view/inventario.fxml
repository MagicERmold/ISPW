<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="page" xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.stocktrack.view.fx.controller.InventarioFXController">
    <top>
        <VBox spacing="8" styleClass="header">
            <padding>
                <Insets top="18" right="24" bottom="12" left="24"/>
            </padding>
            <Label styleClass="title" text="Inventario"/>
            <Label fx:id="summaryLabel" styleClass="subtitle" text="Prodotti: 0"/>
            <HBox spacing="10">
                <Button onAction="#onRefreshInventory" text="Aggiorna"/>
                <Button fx:id="suppliersButton" onAction="#onManageSuppliers" text="Fornitori"/>
                <Button fx:id="buyFromSuppliersButton" onAction="#onBuyFromSuppliers" text="Acquista da fornitori"/>
                <Button onAction="#onLogout" text="Logout"/>
            </HBox>
        </VBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true" styleClass="content">
            <TilePane fx:id="inventoryTilePane" hgap="18" prefColumns="3" vgap="18">
                <padding>
                    <Insets top="20" right="24" bottom="20" left="24"/>
                </padding>
            </TilePane>
        </ScrollPane>
    </center>
    <bottom>
        <Label fx:id="messageLabel" styleClass="message">
            <padding>
                <Insets top="10" right="24" bottom="14" left="24"/>
            </padding>
        </Label>
    </bottom>
</BorderPane>
