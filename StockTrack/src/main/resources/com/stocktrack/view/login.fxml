<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane styleClass="auth-screen" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.stocktrack.view.fx.controller.LoginGraphicalController">
    <HBox alignment="CENTER" maxHeight="500.0" maxWidth="860.0" styleClass="auth-shell">
        <VBox alignment="CENTER_LEFT" prefWidth="380.0" spacing="18.0" styleClass="brand-panel">
            <padding>
                <Insets bottom="42.0" left="42.0" right="42.0" top="42.0" />
            </padding>
            <Label styleClass="brand-title" text="StockTrack" />
            <Label styleClass="brand-subtitle" text="Inventario, gruppi e lista spesa in un unico spazio." wrapText="true" />
            <Label styleClass="brand-chip" text="DEMO / FULL / DBMS" />
        </VBox>

        <VBox alignment="CENTER_LEFT" prefWidth="430.0" spacing="16.0" styleClass="auth-card">
            <padding>
                <Insets bottom="42.0" left="42.0" right="42.0" top="42.0" />
            </padding>
            <Label styleClass="title-label" text="Accedi" />
            <Label styleClass="text-secondary" text="Bentornato nel tuo magazzino." />

            <TextField fx:id="usernameField" maxWidth="320.0" promptText="Username" />
            <PasswordField fx:id="passwordField" maxWidth="320.0" promptText="Password" />

            <Button defaultButton="true" maxWidth="320.0" onAction="#handleLogin" prefWidth="320.0" styleClass="primary-button" text="Accedi" />
            <Button maxWidth="320.0" onAction="#switchToRegister" prefWidth="320.0" styleClass="link-button" text="Crea un account" />
        </VBox>
    </HBox>
</StackPane>
