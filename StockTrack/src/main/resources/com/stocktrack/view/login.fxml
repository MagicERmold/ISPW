<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="page" xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.stocktrack.view.fx.controller.LoginFXController">
    <center>
        <VBox alignment="CENTER_LEFT" maxWidth="420" spacing="14" styleClass="panel">
            <padding>
                <Insets top="28" right="28" bottom="28" left="28"/>
            </padding>
            <Label styleClass="title" text="StockTrack"/>
            <Label styleClass="subtitle" text="Accesso operatore"/>
            <TextField fx:id="emailField" promptText="Email utente"/>
            <PasswordField fx:id="passwordField" promptText="Password"/>
            <Button maxWidth="Infinity" onAction="#onLogin" text="Accedi"/>
            <Button maxWidth="Infinity" onAction="#onOpenRegistration" text="Crea account"/>
            <Label fx:id="messageLabel" styleClass="error"/>
        </VBox>
    </center>
</BorderPane>
