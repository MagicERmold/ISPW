<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="page" xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.stocktrack.view.fx.controller.RegistrazioneFXController">
    <center>
        <VBox alignment="CENTER_LEFT" maxWidth="420" spacing="14" styleClass="panel">
            <padding>
                <Insets top="28" right="28" bottom="28" left="28"/>
            </padding>
            <Label styleClass="title" text="Registrazione"/>
            <Label styleClass="subtitle" text="Crea un nuovo account StockTrack"/>
            <TextField fx:id="nameField" promptText="Nome"/>
            <TextField fx:id="surnameField" promptText="Cognome"/>
            <TextField fx:id="emailField" promptText="Email utente"/>
            <PasswordField fx:id="passwordField" promptText="Password"/>
            <ComboBox fx:id="roleComboBox" maxWidth="Infinity"/>
            <Button maxWidth="Infinity" onAction="#onRegister" text="Registrati"/>
            <Button maxWidth="Infinity" onAction="#onBackToLogin" text="Torna al login"/>
            <Label fx:id="messageLabel" styleClass="error"/>
        </VBox>
    </center>
</BorderPane>
