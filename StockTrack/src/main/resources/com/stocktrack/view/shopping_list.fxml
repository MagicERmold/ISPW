<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.stocktrack.view.fx.controller.ShoppingListGraphicalController">
    <padding> <Insets top="10" right="10" bottom="10" left="10"/> </padding>

    <Label text="Prodotti in Esaurimento" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
    <Label text="Questi prodotti sono scesi sotto la soglia minima." textFill="GREY"/>

    <TableView fx:id="shoppingTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="nameCol" text="Prodotto" prefWidth="150"/>
            <TableColumn fx:id="categoryCol" text="Categoria" prefWidth="120"/>
            <TableColumn fx:id="qtyCol" text="Quantità Attuale" prefWidth="120"/>
            <TableColumn fx:id="thresholdCol" text="Soglia Minima" prefWidth="120"/>
            <TableColumn fx:id="missingCol" text="Da Ordinare" prefWidth="120" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
        <placeholder>
            <Label text="Tutto ok! Nessun prodotto in esaurimento."/>
        </placeholder>
    </TableView>
</VBox>