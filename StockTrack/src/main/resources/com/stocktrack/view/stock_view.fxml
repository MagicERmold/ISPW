<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane styleClass="content-view" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.stocktrack.view.fx.controller.StockGraphicalController">

    <top>
        <VBox spacing="12.0" styleClass="section-header">
            <padding><Insets top="22" right="24" bottom="14" left="24"/></padding>
            <HBox alignment="CENTER_LEFT" spacing="12.0">
                <Label styleClass="section-title" text="Magazzino" />
                <Region HBox.hgrow="ALWAYS" />
                <HBox alignment="CENTER_LEFT" spacing="8.0" styleClass="legend-bar">
                    <Label styleClass="legend-dot-low" text=" " />
                    <Label styleClass="legend-label" text="Sotto soglia" />
                    <Label styleClass="legend-dot-empty" text=" " />
                    <Label styleClass="legend-label" text="Esaurito" />
                </HBox>
                <Button onAction="#handleRefresh" styleClass="secondary-button" text="Aggiorna" />
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <VBox styleClass="dashboard-tile" HBox.hgrow="ALWAYS">
                    <Label styleClass="dashboard-label" text="Prodotti totali" />
                    <Label fx:id="totalProductsLabel" styleClass="dashboard-value" text="0" />
                </VBox>
                <VBox styleClass="dashboard-tile" HBox.hgrow="ALWAYS">
                    <Label styleClass="dashboard-label" text="Sotto soglia" />
                    <Label fx:id="lowStockProductsLabel" styleClass="dashboard-value" text="0" />
                </VBox>
                <VBox styleClass="dashboard-tile" HBox.hgrow="ALWAYS">
                    <Label styleClass="dashboard-label" text="Esauriti" />
                    <Label fx:id="emptyProductsLabel" styleClass="dashboard-value" text="0" />
                </VBox>
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="12.0">
                <TextField fx:id="txtSearch" HBox.hgrow="ALWAYS" promptText="Cerca per nome o categoria" />
                <Label styleClass="field-label" text="Categoria" />
                <ComboBox fx:id="cmbFilterCategory" prefWidth="180" promptText="Tutte" />
                <Label styleClass="field-label" text="Stato" />
                <ComboBox fx:id="cmbFilterStatus" prefWidth="160" promptText="Tutte" />
            </HBox>
        </VBox>
    </top>


    <center>
        <TableView fx:id="stockTable" styleClass="data-table">
            <columns>
                <TableColumn fx:id="colName" prefWidth="180" text="Prodotto"/>
                <TableColumn fx:id="colCategory" prefWidth="140" text="Categoria"/>
                <TableColumn fx:id="colQuantity" prefWidth="110" text="Quantita"/>
                <TableColumn fx:id="colThreshold" prefWidth="120" text="Soglia"/>
                <TableColumn fx:id="colStatus" prefWidth="120" text="Stato"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
            <placeholder>
                <Label text="Nessun prodotto nel magazzino."/>
            </placeholder>
        </TableView>
    </center>

    <bottom>
        <VBox spacing="12.0" styleClass="form-panel">
            <padding><Insets top="16" right="24" bottom="22" left="24"/></padding>
            <Label styleClass="panel-title" text="Aggiungi prodotto" />

            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <TextField fx:id="txtName" HBox.hgrow="ALWAYS" promptText="Nome prodotto"/>
                <VBox minWidth="220" prefWidth="220" maxWidth="220" spacing="6.0">
                    <ComboBox fx:id="cmbProductCategory" maxWidth="Infinity" promptText="Categoria"/>
                    <Button maxWidth="Infinity" onAction="#handleAddCategory" styleClass="secondary-button" text="+ Categoria"/>
                </VBox>
                <TextField fx:id="txtQuantity" prefWidth="100" promptText="Quantita"/>
                <TextField fx:id="txtThreshold" prefWidth="100" promptText="Soglia"/>
                <Button onAction="#handleAddStock" styleClass="primary-button" text="Aggiungi"/>
            </HBox>

            <HBox alignment="CENTER_RIGHT" spacing="10.0">
                <Label fx:id="feedbackLabel" HBox.hgrow="ALWAYS" styleClass="feedback-label" text="" />
                <Button onAction="#handleEditThreshold" styleClass="secondary-button" text="Modifica soglia"/>
                <Button onAction="#handleDeleteStock" styleClass="danger-button" text="Rimuovi selezionato"/>
            </HBox>
        </VBox>
    </bottom>

</BorderPane>
