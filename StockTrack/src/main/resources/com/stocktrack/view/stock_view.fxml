<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.stocktrack.view.fx.controller.StockGraphicalController"
            stylesheets="@style.css">

    <top>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
            <Label text="Gestione Magazzino" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

            <Region HBox.hgrow="ALWAYS" />

            <Label text="Filtra per:" />
            <ComboBox fx:id="cmbFilterCategory" promptText="Tutte le Categorie" prefWidth="150" />
            <Button text="Aggiorna" onAction="#handleRefresh"/>
        </HBox>
    </top>

    <center>
        <TableView fx:id="stockTable">
            <columns>
                <TableColumn fx:id="colName" text="Prodotto" prefWidth="150"/>
                <TableColumn fx:id="colCategory" text="Categoria" prefWidth="120"/>
                <TableColumn fx:id="colQuantity" text="Quantità" prefWidth="100"/>
                <TableColumn fx:id="colThreshold" text="Soglia Minima" prefWidth="100"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
    </center>

    <bottom>
        <VBox spacing="10">
            <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <TextField fx:id="txtName" promptText="Nome Prodotto"/>
                <TextField fx:id="txtCategory" promptText="Categoria (es. Cibo)"/>
                <TextField fx:id="txtQuantity" promptText="Quantità" prefWidth="80"/>
                <TextField fx:id="txtThreshold" promptText="Soglia" prefWidth="80"/>
                <Button text="Aggiungi Prodotto" onAction="#handleAddStock"/>
            </HBox>

            <HBox spacing="10" alignment="CENTER_RIGHT">
                <Button text="Rimuovi Selezionato" onAction="#handleDeleteStock"/>
            </HBox>
        </VBox>
    </bottom>

</BorderPane>