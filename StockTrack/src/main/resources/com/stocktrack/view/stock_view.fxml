<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane styleClass="content-view" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.stocktrack.view.fx.controller.StockGraphicalController">

    <top>
        <VBox spacing="12.0" styleClass="section-header">
            <padding><Insets top="22" right="24" bottom="14" left="24"/></padding>
            <HBox alignment="CENTER_LEFT" spacing="12.0">
                <Label styleClass="section-title" text="Magazzino" />
                <Region HBox.hgrow="ALWAYS" />
                <Label styleClass="field-label" text="Categoria" />
                <ComboBox fx:id="cmbFilterCategory" prefWidth="180" promptText="Tutte" />
                <Button onAction="#handleRefresh" styleClass="secondary-button" text="Aggiorna" />
            </HBox>
        </VBox>
    </top>


    <center>
        <TableView fx:id="stockTable" styleClass="data-table">
            <columns>
                <TableColumn fx:id="colName" prefWidth="180" text="Prodotto"/>
                <TableColumn fx:id="colCategory" prefWidth="140" text="Categoria"/>
                <TableColumn fx:id="colQuantity" prefWidth="110" text="Quantita"/>
                <TableColumn fx:id="colThreshold" prefWidth="120" text="Soglia"/>
                <TableColumn fx:id="colStatus" prefWidth="120" text="Stato"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
            <placeholder>
                <Label text="Nessun prodotto nel magazzino."/>
            </placeholder>
        </TableView>
    </center>

    <bottom>
        <VBox spacing="12.0" styleClass="form-panel">
            <padding><Insets top="16" right="24" bottom="22" left="24"/></padding>
            <Label styleClass="panel-title" text="Aggiungi prodotto" />

            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <TextField fx:id="txtName" HBox.hgrow="ALWAYS" promptText="Nome prodotto"/>
                <TextField fx:id="txtCategory" HBox.hgrow="ALWAYS" promptText="Categoria"/>
                <TextField fx:id="txtQuantity" prefWidth="100" promptText="Quantita"/>
                <TextField fx:id="txtThreshold" prefWidth="100" promptText="Soglia"/>
                <Button onAction="#handleAddStock" styleClass="primary-button" text="Aggiungi"/>
            </HBox>

            <HBox alignment="CENTER_RIGHT" spacing="10.0">
                <Button onAction="#handleDeleteStock" styleClass="danger-button" text="Rimuovi selezionato"/>
            </HBox>
        </VBox>
    </bottom>

</BorderPane>
