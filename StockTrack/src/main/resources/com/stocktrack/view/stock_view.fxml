<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.stocktrack.view.fx.controller.StockGraphicalController">
    <padding> <Insets top="10" right="10" bottom="10" left="10"/> </padding>

    <TableView fx:id="stockTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="nameCol" text="Nome Prodotto" prefWidth="200"/>
            <TableColumn fx:id="qtyCol" text="Quantità" prefWidth="100"/>
            <TableColumn fx:id="thresholdCol" text="Soglia Minima" prefWidth="100"/>
        </columns>
    </TableView>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Button text="consuma (-)" onAction="#onConsume"/>
        <Button text="acquista (+)" onAction="#onPurchase"/>
        <Button text="Elimina Prodotto" onAction="#onDelete" style="-fx-text-fill: red;"/>
    </HBox>

    <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-border-color: lightgrey; -fx-padding: 5;">
        <TextField fx:id="newNameField" promptText="Nome"/>
        <TextField fx:id="newQtyField" promptText="Q.tà" prefWidth="60"/>
        <TextField fx:id="newThresholdField" promptText="Soglia" prefWidth="60"/>
        <Button text="Aggiungi Nuovo" onAction="#onAddProduct"/>
    </HBox>
</VBox>