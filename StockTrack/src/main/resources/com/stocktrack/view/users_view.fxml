<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.stocktrack.view.fx.controller.UsersGraphicalController">
    <padding> <Insets top="10" right="10" bottom="10" left="10"/> </padding>

    <Label text="Gestione Membri Gruppo" styleClass="title-label"/>

    <TableView fx:id="usersTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="usernameCol" text="Username" prefWidth="200"/>
            <TableColumn fx:id="roleCol" text="Ruolo" prefWidth="150"/>
        </columns>
        <placeholder>
            <Label text="Nessun altro utente nel gruppo."/>
        </placeholder>
    </TableView>

    <Button text="Rimuovi Utente Selezionato" onAction="#handleRemoveUser" styleClass="danger-button"/>
</VBox>